# 复制为 .env 并填入你自己的值；切勿提交 .env
# --- 飞书自建应用（多维表格读写 / 消息推送）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OWNER_OPEN_ID=
FEISHU_RECEIVE_OPEN_ID=
# feishu_send.py --app <name> 时使用的具名应用（示例：scout）
FEISHU_SCOUT_APP_ID=
FEISHU_SCOUT_APP_SECRET=
FEISHU_SCOUT_RECEIVE_OPEN_ID=
# tools/amazon-keyword-rank 日报所用多维表格
FEISHU_RANK_BITABLE_TOKEN=
FEISHU_RANK_HIST_TABLE_ID=
FEISHU_BASE_URL_PREFIX=
# --- Sorftime MCP ---
SORFTIME_KEY=
# --- Etsy Open API v3 ---
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# --- 可选 ---
LOC_PROBE_ASIN=
ABA_REPORT_ROOT=
# --- SIF（可选，见 amazon-ads-diagnostics/sif-tools-quick-ref.md）---
SIF_API_TOKEN=
